                entity.ToTable("significado_id");
                entity.HasKey(e => e.IdSignificadoId);

                // Configure ID_SIGNIFICADO_ID as IDENTITY (auto-generated)
                entity.Property(e => e.IdSignificadoId)
                    .ValueGeneratedOnAdd();

                // Configure rv as timestamp (rowversion)
                entity.Property(e => e.Rv)
                    .IsRowVersion()
                    .ValueGeneratedOnAddOrUpdate();
            });

            // Configure Edificio entity
            modelBuilder.Entity<Edificio>(entity =>
            {
                entity.ToTable("edificio");
                entity.HasKey(e => e.IdEdificio);

                // Configure ID_EDIFICIO as IDENTITY (auto-generated)
                entity.Property(e => e.IdEdificio)
                    .ValueGeneratedOnAdd();

                // Configure rv as timestamp (rowversion)
                entity.Property(e => e.Rv)
                    .IsRowVersion()
                    .ValueGeneratedOnAddOrUpdate();

                // Note: FK relationships not configured, navigation properties loaded manually
            });

            // Configure VEdificio view
            modelBuilder.Entity<VEdificio>(entity =>
            {
                entity.ToView("vEdificio");
                entity.HasKey(e => e.IdEdificio);
            });

            // Configure Control entity
            modelBuilder.Entity<Control>(entity =>
            {
                entity.ToTable("control");
                entity.HasKey(e => e.IdControl);

                // Configure ID_CONTROL as IDENTITY (auto-generated)
                entity.Property(e => e.IdControl)
                    .ValueGeneratedOnAdd();

                // Configure rv as timestamp (rowversion)
                entity.Property(e => e.Rv)
                    .IsRowVersion()
                    .ValueGeneratedOnAddOrUpdate();
            });

            // Configure ConceptoContable entity
            modelBuilder.Entity<ConceptoContable>(entity =>
            {
                entity.ToTable("concepto_contable");
                entity.HasKey(e => e.IdConcepto);

                // Configure ID_CONCEPTO to not be auto-generated
                entity.Property(e => e.IdConcepto)
                    .ValueGeneratedNever();

                // Configure foreign key relationships
                entity.HasOne(e => e.Compania)
                    .WithMany()
                    .HasForeignKey(e => e.IdCompania)
                    .OnDelete(DeleteBehavior.Restrict);

                entity.HasOne(e => e.TipoActivo)
                    .WithMany()
                    .HasForeignKey(e => e.IdTipoActivo)
                    .OnDelete(DeleteBehavior.Restrict);

                entity.HasOne(e => e.SubtipoActivo)
                    .WithMany()
                    .HasForeignKey(e => e.IdSubtipoActivo)
                    .OnDelete(DeleteBehavior.Restrict);
            });

            // Configure VConceptoContable view
            modelBuilder.Entity<VConceptoContable>(entity =>
            {
                entity.ToView("vConcepto_contable");
                entity.HasKey(e => e.IdConcepto);
            });

            // Configure Piso entity
            modelBuilder.Entity<Piso>(entity =>
            {
                entity.ToTable("piso");
                entity.HasKey(e => e.IdPiso);

                // Configure ID_PISO as IDENTITY (auto-generated)
                entity.Property(e => e.IdPiso)
                    .ValueGeneratedOnAdd();

                // Configure rv as timestamp (rowversion)
                entity.Property(e => e.Rv)
                    .IsRowVersion()
                    .ValueGeneratedOnAddOrUpdate();

                // Note: FK relationship to Compania not configured due to type mismatch
                // (piso.ID_COMPANIA is int?, compania.ID_COMPANIA is short)
                // Navigation property will be loaded manually in controller
            });

            // Configure PeriodosCerrados entity
            modelBuilder.Entity<PeriodosCerrados>(entity =>
            {
                entity.ToTable("PeriodosCerrados");
                entity.HasKey(e => e.IdCierreCompania);

                // Configure Id_Cierre_Compania as IDENTITY (auto-generated)
                entity.Property(e => e.IdCierreCompania)
                    .ValueGeneratedOnAdd();

                // Configure foreign key relationship to Compania
                entity.HasOne(e => e.Compania)
                    .WithMany()
                    .HasForeignKey(e => e.IdCompania)
                    .OnDelete(DeleteBehavior.Restrict);

                // Configure foreign key relationship to TipoDepreciacion
                entity.HasOne(e => e.TipoDepreciacion)
                    .WithMany()
                    .HasForeignKey(e => e.IdTipoDep)
                    .OnDelete(DeleteBehavior.Restrict);
            });

            // Configure TipoCalculo entity
            modelBuilder.Entity<TipoCalculo>(entity =>
