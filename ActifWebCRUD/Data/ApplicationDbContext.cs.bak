                entity.ToTable("centro_costo");
                entity.HasKey(e => e.IdCentroCosto);

                // Configure ID_CENTRO_COSTO as IDENTITY (auto-generated)
                entity.Property(e => e.IdCentroCosto)
                    .ValueGeneratedOnAdd();

                // Configure rv as timestamp (rowversion)
                entity.Property(e => e.Rv)
