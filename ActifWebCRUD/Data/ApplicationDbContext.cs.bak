using Microsoft.EntityFrameworkCore;
using ActifWebCRUD.Models;

namespace ActifWebCRUD.Data
{
    public class ApplicationDbContext : DbContext
    {
        public ApplicationDbContext(DbContextOptions<ApplicationDbContext> options)
            : base(options)
        {
        }

        public DbSet<Compania> Compania { get; set; }
        public DbSet<TipoDepreciacion> TipoDepreciacion { get; set; }
        public DbSet<TipoActivo> TipoActivo { get; set; }
        public DbSet<SubtipoActivo> SubtipoActivo { get; set; }
        public DbSet<EstadoActivo> EstadoActivo { get; set; }
        public DbSet<TipoMovimiento> TipoMovimiento { get; set; }
        public DbSet<SubtipoMovimiento> SubtipoMovimiento { get; set; }
        public DbSet<Pais> Pais { get; set; }
        public DbSet<Estado> Estado { get; set; }
        public DbSet<VEstado> VEstado { get; set; }
        public DbSet<Moneda> Moneda { get; set; }
        public DbSet<ClaseTipoCambio> ClaseTipoCambio { get; set; }
        public DbSet<Area> Area { get; set; }
        public DbSet<Responsable> Responsable { get; set; }
        public DbSet<VResponsable> VResponsable { get; set; }
        public DbSet<CentroCosto> CentroCosto { get; set; }
        public DbSet<VCentroCosto> VCentroCosto { get; set; }
        public DbSet<GrupoSimulacion> GrupoSimulacion { get; set; }
        public DbSet<Control> Control { get; set; }
        public DbSet<SignificadoId> SignificadoId { get; set; }
        public DbSet<Edificio> Edificio { get; set; }
        public DbSet<VEdificio> VEdificio { get; set; }
        public DbSet<ConceptoContable> ConceptoContable { get; set; }
        public DbSet<VConceptoContable> VConceptoContable { get; set; }
        public DbSet<Piso> Piso { get; set; }
        public DbSet<PeriodosCerrados> PeriodosCerrados { get; set; }
        public DbSet<TipoCalculo> TipoCalculo { get; set; }
        public DbSet<GrupoEdificio> GrupoEdificio { get; set; }
        public DbSet<EdificioPiso> EdificioPiso { get; set; }
        public DbSet<PlantillaEdificio> PlantillaEdificio { get; set; }
        public DbSet<PlantillaEdificioDetalle> PlantillaEdificioDetalle { get; set; }
        public DbSet<EdificioCentroCosto> EdificioCentroCosto { get; set; }
        public DbSet<ActifConfigPlaca> ActifConfigPlaca { get; set; }
        public DbSet<INPC2> INPC2 { get; set; }
        public DbSet<GrupoEdificioDetalle> GrupoEdificioDetalle { get; set; }
        public DbSet<ActifCompaniaTipoDepreciacion> ActifCompaniaTipoDepreciacion { get; set; }

        protected override void OnModelCreating(ModelBuilder modelBuilder)
        {
            base.OnModelCreating(modelBuilder);

            // Configure Compania entity
            modelBuilder.Entity<Compania>(entity =>
            {
                entity.ToTable("compania");
                entity.HasKey(e => e.IdCompania);
            });

            // Configure TipoDepreciacion entity
            modelBuilder.Entity<TipoDepreciacion>(entity =>
            {
                entity.ToTable("tipo_depreciacion");
                entity.HasKey(e => e.IdTipoDep);
            });

            // Configure TipoActivo entity
            modelBuilder.Entity<TipoActivo>(entity =>
            {
                entity.ToTable("tipo_activo");
                entity.HasKey(e => e.IdTipoActivo);

                // Configure ID_TIPO_ACTIVO to not be auto-generated
                entity.Property(e => e.IdTipoActivo)
                    .ValueGeneratedNever();

                // Configure rv as timestamp (rowversion)
                entity.Property(e => e.Rv)
                    .IsRowVersion()
                    .ValueGeneratedOnAddOrUpdate();

                // Configure foreign key relationship
                entity.HasOne(e => e.Compania)
                    .WithMany()
                    .HasForeignKey(e => e.IdCompania)
                    .OnDelete(DeleteBehavior.Restrict);
            });

            // Configure SubtipoActivo entity
            modelBuilder.Entity<SubtipoActivo>(entity =>
            {
                entity.ToTable("subtipo_activo");
                entity.HasKey(e => e.IdSubtipoActivo);

                // Configure ID_SUBTIPO_ACTIVO to not be auto-generated (IsIdentity = 0)
                entity.Property(e => e.IdSubtipoActivo)
                    .ValueGeneratedNever();

                // Configure rv as timestamp (rowversion)
                entity.Property(e => e.Rv)
                    .IsRowVersion()
                    .ValueGeneratedOnAddOrUpdate();

                // Configure foreign key relationship
                entity.HasOne(e => e.TipoActivo)
                    .WithMany()
                    .HasForeignKey(e => e.IdTipoActivo)
                    .OnDelete(DeleteBehavior.Restrict);
            });

            // Configure EstadoActivo entity
            modelBuilder.Entity<EstadoActivo>(entity =>
            {
                entity.ToTable("estado_activo");
                entity.HasKey(e => e.IdEstadoActivo);

                // Configure ID_ESTADO_ACTIVO as IDENTITY (auto-generated)
                entity.Property(e => e.IdEstadoActivo)
                    .ValueGeneratedOnAdd();

                // Configure rv as timestamp (rowversion)
                entity.Property(e => e.Rv)
                    .IsRowVersion()
                    .ValueGeneratedOnAddOrUpdate();
            });

            // Configure TipoMovimiento entity
            modelBuilder.Entity<TipoMovimiento>(entity =>
            {
                entity.ToTable("tipo_movimiento");
                entity.HasKey(e => e.IdTipoMov);

                // Configure ID_TIPO_MOV as IDENTITY (auto-generated)
                entity.Property(e => e.IdTipoMov)
                    .ValueGeneratedOnAdd();
            });

            // Configure SubtipoMovimiento entity
            modelBuilder.Entity<SubtipoMovimiento>(entity =>
            {
                entity.ToTable("subtipo_movimiento");
                entity.HasKey(e => e.IdSubtipoMov);

                // Configure ID_SUBTIPO_MOV as IDENTITY (auto-generated)
                entity.Property(e => e.IdSubtipoMov)
                    .ValueGeneratedOnAdd();

                // Configure foreign key relationship
                entity.HasOne(e => e.TipoMovimiento)
                    .WithMany()
                    .HasForeignKey(e => e.IdTipoMov)
                    .OnDelete(DeleteBehavior.Restrict);
            });

            // Configure Pais entity
            modelBuilder.Entity<Pais>(entity =>
            {
                entity.ToTable("pais");
                entity.HasKey(e => e.IdPais);

                // Configure ID_PAIS as IDENTITY (auto-generated)
                entity.Property(e => e.IdPais)
                    .ValueGeneratedOnAdd();

                // Configure rv as timestamp (rowversion)
                entity.Property(e => e.Rv)
                    .IsRowVersion()
                    .ValueGeneratedOnAddOrUpdate();
            });

            // Configure Estado entity
            modelBuilder.Entity<Estado>(entity =>
            {
                entity.ToTable("estado");
                entity.HasKey(e => e.IdEstado);

                // Configure ID_ESTADO as IDENTITY (auto-generated)
                entity.Property(e => e.IdEstado)
                    .ValueGeneratedOnAdd();

                // Note: FK relationship to Pais not configured due to type mismatch
                // (estado.ID_PAIS is smallint, pais.ID_PAIS is int)
                // Navigation property will be loaded manually in controller
            });

            // Configure VEstado view
            modelBuilder.Entity<VEstado>(entity =>
            {
                entity.ToView("vEstado");
                entity.HasKey(e => e.IdEstado);
            });

            // Configure Moneda entity
            modelBuilder.Entity<Moneda>(entity =>
            {
                entity.ToTable("moneda");
                entity.HasKey(e => e.IdMoneda);

                // Configure ID_MONEDA as IDENTITY (auto-generated)
                entity.Property(e => e.IdMoneda)
                    .ValueGeneratedOnAdd();

                // Configure rv as timestamp (rowversion)
                entity.Property(e => e.Rv)
                    .IsRowVersion()
                    .ValueGeneratedOnAddOrUpdate();

                // Configure foreign key relationship
                entity.HasOne(e => e.Pais)
                    .WithMany()
                    .HasForeignKey(e => e.IdPais)
                    .OnDelete(DeleteBehavior.Restrict);
            });

            // Configure ClaseTipoCambio entity
            modelBuilder.Entity<ClaseTipoCambio>(entity =>
            {
                entity.ToTable("clase_tipo_cambio");
                entity.HasKey(e => e.IdClaseTipCam);

                // Configure ID_CLASE_TIPCAM to not be auto-generated (IsIdentity = 0)
                entity.Property(e => e.IdClaseTipCam)
                    .ValueGeneratedNever();
            });

            // Configure Area entity
            modelBuilder.Entity<Area>(entity =>
            {
                entity.ToTable("area");
                entity.HasKey(e => e.IdArea);

                // Configure ID_AREA as IDENTITY (auto-generated)
                entity.Property(e => e.IdArea)
                    .ValueGeneratedOnAdd();

                // Configure rv as timestamp (rowversion)
                entity.Property(e => e.Rv)
                    .IsRowVersion()
                    .ValueGeneratedOnAddOrUpdate();
            });

            // Configure Responsable entity
            modelBuilder.Entity<Responsable>(entity =>
            {
                entity.ToTable("responsable");
                entity.HasKey(e => e.IdResponsable);

                // Configure ID_RESPONSABLE as IDENTITY (auto-generated)
                entity.Property(e => e.IdResponsable)
