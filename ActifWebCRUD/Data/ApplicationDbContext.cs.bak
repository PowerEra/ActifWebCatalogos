            // Configure GrupoSimulacion entity
            modelBuilder.Entity<GrupoSimulacion>(entity =>
            {
                entity.ToTable("grupo_simulacion");
                entity.HasKey(e => e.IdGrupoSimulacion);

                // Configure ID_GRUPO_SIMULACION as IDENTITY (auto-generated)
                entity.Property(e => e.IdGrupoSimulacion)
