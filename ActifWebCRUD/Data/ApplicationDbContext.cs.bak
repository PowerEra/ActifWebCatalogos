                entity.ToTable("grupoEdificio");
                entity.HasKey(e => e.IdGrupo);

                // Configure IdGrupo as IDENTITY (auto-generated)
                entity.Property(e => e.IdGrupo)
                    .ValueGeneratedOnAdd();
            });

            // Configure EdificioPiso entity
            modelBuilder.Entity<EdificioPiso>(entity =>
            {
                entity.ToTable("edificio_piso");
                entity.HasKey(e => new { e.IdCompania, e.IdEdificio, e.IdPiso });

                // Configure composite key properties to not be auto-generated
                entity.Property(e => e.IdCompania)
                    .ValueGeneratedNever();
                entity.Property(e => e.IdEdificio)
                    .ValueGeneratedNever();
                entity.Property(e => e.IdPiso)
                    .ValueGeneratedNever();

                // Note: FK relationships not configured, navigation properties loaded manually
            });

            // Configure PlantillaEdificio entity
            modelBuilder.Entity<PlantillaEdificio>(entity =>
            {
                entity.ToTable("PlantillaEdificio");
                entity.HasKey(e => e.IdPlantilla);

                // Configure IdPlantilla as IDENTITY (auto-generated)
                entity.Property(e => e.IdPlantilla)
                    .ValueGeneratedOnAdd();

                // Note: FK relationships not configured, navigation properties loaded manually
            });

            // Configure PlantillaEdificioDetalle entity
            modelBuilder.Entity<PlantillaEdificioDetalle>(entity =>
            {
                entity.ToTable("plantillaedificiodetalle");
                entity.HasKey(e => e.IdPlantillaDetalle);

                // Configure IdPlantillaDetalle as IDENTITY (auto-generated)
                entity.Property(e => e.IdPlantillaDetalle)
                    .ValueGeneratedOnAdd();

                // Note: FK relationships not configured, navigation properties loaded manually
            });

            // Configure EdificioCentroCosto entity
            modelBuilder.Entity<EdificioCentroCosto>(entity =>
            {
                entity.ToTable("edificio_centro_costo");
                entity.HasKey(e => e.IdEdificioCentroCosto);

                // Configure ID_EDIFICIO_CENTRO_COSTO as IDENTITY (auto-generated)
                entity.Property(e => e.IdEdificioCentroCosto)
                    .ValueGeneratedOnAdd();

                // Note: FK relationships not configured, navigation properties loaded manually
            });

            // Configure ActifConfigPlaca entity
            modelBuilder.Entity<ActifConfigPlaca>(entity =>
            {
                entity.ToTable("actif_config_placa");
                entity.HasKey(e => e.IdConfigPlaca);

                // Configure ID_CONFIG_PLACA as IDENTITY (auto-generated)
                entity.Property(e => e.IdConfigPlaca)
                    .ValueGeneratedOnAdd();

                // Configure RV as timestamp (rowversion)
                entity.Property(e => e.Rv)
                    .IsRowVersion()
                    .ValueGeneratedOnAddOrUpdate();

                // Note: FK relationship to Compania not configured due to type mismatch
                // (actif_config_placa.ID_COMPANIA is int, compania.ID_COMPANIA is short)
                // Navigation property will be loaded manually in controller
            });

            // Configure GrupoEdificioDetalle entity
            modelBuilder.Entity<GrupoEdificioDetalle>(entity =>
            {
                entity.ToTable("grupoEdificioDetalle");
                entity.HasKey(e => e.IdGE);

                // Configure IdGE as IDENTITY (auto-generated)
                entity.Property(e => e.IdGE)
