@model ActifWebCRUD.Models.GrupoEdificio

@{
    ViewData["Title"] = "Eliminar Grupo Edificio";
}

<div class="crud-container">
    <h1 class="crud-title">Eliminar Grupo Edificio</h1>

    <h3>¿Está seguro que desea eliminar este grupo de edificio?</h3>
    <div class="form-container">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdGrupo)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IdGrupo)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Grupo)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Grupo)
            </dd>
        </dl>

        <form asp-action="Delete" id="grupoedificio_delete_form">
            <input type="hidden" asp-for="IdGrupo" />
            <button type="submit" class="btn btn-danger" id="grupoedificio_delete_submit">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary" id="grupoedificio_delete_cancel">Cancelar</a>
        </form>
    </div>
</div>
