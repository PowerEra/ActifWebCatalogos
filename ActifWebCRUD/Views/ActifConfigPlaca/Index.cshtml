@model IEnumerable<ActifWebCRUD.Models.ActifConfigPlaca>

@{
    ViewData["Title"] = "Configuracion de Placas";
}

<div class="crud-container">
    <h1 class="crud-title">Configuracion de Placas</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="actifconfigplaca_add_button">
            <i class="fas fa-plus"></i> Agregar Nueva Configuracion
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="actifconfigplaca_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="actifConfigPlacaTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID Config Placa</th>
                <th>Compañía</th>
                <th>Prefijo</th>
                <th>Min Digitos</th>
                <th>Max Digitos</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Compañía" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Prefijo" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Min" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Max" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdConfigPlaca</td>
                    <td>@(item.Compania?.Nombre ?? "")</td>
                    <td>@item.Prefijo</td>
                    <td>@item.MinDigitos</td>
                    <td>@item.MaxDigitos</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdConfigPlaca" class="action-icon icon-edit" title="Editar" id="actifconfigplaca_edit_@item.IdConfigPlaca">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdConfigPlaca" class="action-icon icon-delete" title="Eliminar" id="actifconfigplaca_delete_@item.IdConfigPlaca">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#actifConfigPlacaTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 5 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 5) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "ActifConfigPlaca")';
        }
    </script>
}
