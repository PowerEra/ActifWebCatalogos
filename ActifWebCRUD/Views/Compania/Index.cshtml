@model IEnumerable<ActifWebCRUD.Models.Compania>

@{
    ViewData["Title"] = "Companias";
}

<div class="crud-container">
    <h1 class="crud-title">Companias</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="compania_add_button">
            <i class="fas fa-plus"></i> Agregar Nueva Compania
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="compania_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="companiaTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>RFC</th>
                <th>Fecha Inicio</th>
                <th>Telefono</th>
                <th>Division</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Nombre" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar RFC" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Fecha" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Telefono" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Division" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdCompania</td>
                    <td>@item.Nombre</td>
                    <td>@item.Rfc</td>
                    <td>@(item.FechaInicioEjerc?.ToString("yyyy-MM-dd") ?? "")</td>
                    <td>@item.Telefono</td>
                    <td>@item.Division</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdCompania" class="action-icon icon-edit" title="Editar" id="compania_edit_@item.IdCompania">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdCompania" class="action-icon icon-delete" title="Eliminar" id="compania_delete_@item.IdCompania">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#companiaTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 6 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 6) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "Compania")';
        }
    </script>
}
