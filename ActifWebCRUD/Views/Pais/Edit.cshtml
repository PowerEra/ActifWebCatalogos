@model ActifWebCRUD.Models.Pais

@{
    ViewData["Title"] = "Editar Pais";
}

<div class="crud-container">
    <h1 class="crud-title">Editar Pais</h1>

    <div class="form-container">
        <form asp-action="Edit" id="pais_edit_form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdPais" id="pais_edit_idpais" />

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdPais" class="control-label"></label>
                        <input type="text" value="@Model.IdPais" class="form-control" disabled />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Nombre" class="control-label"></label>
                        <input asp-for="Nombre" class="form-control" id="pais_edit_nombre" maxlength="20" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary" id="pais_edit_submit">Guardar Cambios</button>
                <a asp-action="Index" class="btn btn-secondary" id="pais_edit_cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
