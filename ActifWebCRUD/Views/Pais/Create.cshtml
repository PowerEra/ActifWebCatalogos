@model ActifWebCRUD.Models.Pais

@{
    ViewData["Title"] = "Crear Pais";
}

<div class="crud-container">
    <h1 class="crud-title">Crear Nuevo Pais</h1>

    <div class="form-container">
        <form asp-action="Create" id="pais_create_form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Nombre" class="control-label"></label>
                        <input asp-for="Nombre" class="form-control" id="pais_create_nombre" maxlength="20" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary" id="pais_create_submit">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary" id="pais_create_cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
