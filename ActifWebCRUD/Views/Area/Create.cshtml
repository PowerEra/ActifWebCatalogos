@model ActifWebCRUD.Models.Area

@{
    ViewData["Title"] = "Crear Area";
}

<div class="crud-container">
    <h1 class="crud-title">Crear Nueva Area</h1>

    <div class="form-container">
        <form asp-action="Create" id="area_create_form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Descripcion" class="control-label"></label>
                        <input asp-for="Descripcion" class="form-control" id="area_create_descripcion" />
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Cta1" class="control-label"></label>
                        <input asp-for="Cta1" class="form-control" id="area_create_cta1" />
                        <span asp-validation-for="Cta1" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Cta2" class="control-label"></label>
                        <input asp-for="Cta2" class="form-control" id="area_create_cta2" />
                        <span asp-validation-for="Cta2" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Cta3" class="control-label"></label>
                        <input asp-for="Cta3" class="form-control" id="area_create_cta3" />
                        <span asp-validation-for="Cta3" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Cta4" class="control-label"></label>
                        <input asp-for="Cta4" class="form-control" id="area_create_cta4" />
                        <span asp-validation-for="Cta4" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Cta5" class="control-label"></label>
                        <input asp-for="Cta5" class="form-control" id="area_create_cta5" />
                        <span asp-validation-for="Cta5" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="Cta6" class="control-label"></label>
                        <input asp-for="Cta6" class="form-control" id="area_create_cta6" />
                        <span asp-validation-for="Cta6" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdEdificio" class="control-label"></label>
                        <input asp-for="IdEdificio" class="form-control" type="number" id="area_create_edificio" />
                        <span asp-validation-for="IdEdificio" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdPiso" class="control-label"></label>
                        <input asp-for="IdPiso" class="form-control" type="number" id="area_create_piso" />
                        <span asp-validation-for="IdPiso" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdAreaOrig" class="control-label"></label>
                        <input asp-for="IdAreaOrig" class="form-control" type="number" id="area_create_areaorig" />
                        <span asp-validation-for="IdAreaOrig" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdCompania" class="control-label"></label>
                        <input asp-for="IdCompania" class="form-control" type="number" id="area_create_compania" />
                        <span asp-validation-for="IdCompania" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary" id="area_create_submit">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary" id="area_create_cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
