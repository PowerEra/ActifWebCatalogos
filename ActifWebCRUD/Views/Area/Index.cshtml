@model IEnumerable<ActifWebCRUD.Models.Area>

@{
    ViewData["Title"] = "Areas";
}

<div class="crud-container">
    <h1 class="crud-title">Areas</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="area_add_button">
            <i class="fas fa-plus"></i> Agregar Nueva Area
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="area_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="areaTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID Area</th>
                <th>Descripcion</th>
                <th>Cuenta 1</th>
                <th>Cuenta 2</th>
                <th>Cuenta 3</th>
                <th>ID Edificio</th>
                <th>ID Piso</th>
                <th>ID Compania</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Descripcion" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Cta1" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Cta2" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Cta3" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Edificio" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Piso" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Compania" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdArea</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Cta1</td>
                    <td>@item.Cta2</td>
                    <td>@item.Cta3</td>
                    <td>@item.IdEdificio</td>
                    <td>@item.IdPiso</td>
                    <td>@item.IdCompania</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdArea" class="action-icon icon-edit" title="Editar" id="area_edit_@item.IdArea">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdArea" class="action-icon icon-delete" title="Eliminar" id="area_delete_@item.IdArea">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#areaTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 8 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 8) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "Area")';
        }
    </script>
}
