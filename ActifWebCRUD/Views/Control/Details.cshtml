@model ActifWebCRUD.Models.Control

@{
    ViewData["Title"] = "Detalles Control";
}

<div class="crud-container">
    <h1 class="crud-title">Detalles Control</h1>

    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdControl)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IdControl)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Titulo)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Titulo)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Contenido)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Contenido)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.FlgUsar)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.FlgUsar)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Tipo)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Tipo)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Longitud)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Longitud)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Decimales)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Decimales)
            </dd>
        </dl>
    </div>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.IdControl" class="btn btn-primary" id="control_details_edit">Editar</a>
        <a asp-action="Index" class="btn btn-secondary" id="control_details_back">Volver al Listado</a>
    </div>
</div>
