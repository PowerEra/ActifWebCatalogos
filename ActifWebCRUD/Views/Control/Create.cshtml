@model ActifWebCRUD.Models.Control

@{
    ViewData["Title"] = "Crear Control";
}

<div class="crud-container">
    <h1 class="crud-title">Crear Control</h1>

    <hr />
    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create" id="control_create_form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label"></label>
                    <input asp-for="Titulo" class="form-control" id="control_create_titulo" />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Contenido" class="form-label"></label>
                    <textarea asp-for="Contenido" class="form-control" id="control_create_contenido" rows="3"></textarea>
                    <span asp-validation-for="Contenido" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FlgUsar" class="form-label"></label>
                    <input asp-for="FlgUsar" class="form-control" id="control_create_flgusar" maxlength="2" />
                    <span asp-validation-for="FlgUsar" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tipo" class="form-label"></label>
                    <input asp-for="Tipo" class="form-control" id="control_create_tipo" maxlength="2" />
                    <span asp-validation-for="Tipo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Longitud" class="form-label"></label>
                    <input asp-for="Longitud" class="form-control" id="control_create_longitud" type="number" />
                    <span asp-validation-for="Longitud" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Decimales" class="form-label"></label>
                    <input asp-for="Decimales" class="form-control" id="control_create_decimales" type="number" />
                    <span asp-validation-for="Decimales" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary" id="control_create_submit">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary" id="control_create_cancel">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
