@model IEnumerable<ActifWebCRUD.Models.Control>

@{
    ViewData["Title"] = "Control - Campos Adicionales";
}

<div class="crud-container">
    <h1 class="crud-title">Control - Campos Adicionales</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="control_add_button">
            <i class="fas fa-plus"></i> Agregar Nuevo Control
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="control_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="controlTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID Control</th>
                <th>Titulo</th>
                <th>Contenido</th>
                <th>Flag Usar</th>
                <th>Tipo</th>
                <th>Longitud</th>
                <th>Decimales</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Titulo" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Contenido" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Flag" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Tipo" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Longitud" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Decimales" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdControl</td>
                    <td>@item.Titulo</td>
                    <td>@item.Contenido</td>
                    <td>@item.FlgUsar</td>
                    <td>@item.Tipo</td>
                    <td>@item.Longitud</td>
                    <td>@item.Decimales</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdControl" class="action-icon icon-edit" title="Editar" id="control_edit_@item.IdControl">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdControl" class="action-icon icon-delete" title="Eliminar" id="control_delete_@item.IdControl">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#controlTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 7 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 7) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "Control")';
        }
    </script>
}
