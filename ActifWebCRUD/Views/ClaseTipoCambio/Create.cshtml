@model ActifWebCRUD.Models.ClaseTipoCambio

@{
    ViewData["Title"] = "Crear Clase Tipo de Cambio";
}

<link rel="stylesheet" href="~/css/actif-crud.css" />

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create" id="clasetipocambio_create_form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="IdClaseTipCam" class="control-label"></label>
                    <input asp-for="IdClaseTipCam" class="form-control" id="clasetipocambio_create_idclasetipocam" />
                    <span asp-validation-for="IdClaseTipCam" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Descripcion" class="control-label"></label>
                    <input asp-for="Descripcion" class="form-control" id="clasetipocambio_create_descripcion" />
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Guardar" class="btn btn-primary" id="clasetipocambio_create_guardar" />
                    <a asp-action="Index" class="btn btn-secondary" id="clasetipocambio_create_cancelar">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
