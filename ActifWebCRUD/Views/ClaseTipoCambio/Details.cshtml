@model ActifWebCRUD.Models.ClaseTipoCambio

@{
    ViewData["Title"] = "Detalles de Clase Tipo de Cambio";
}

<link rel="stylesheet" href="~/css/actif-crud.css" />

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.IdClaseTipCam)
                </dt>
                <dd class="col-sm-8" id="clasetipocambio_details_idclasetipocam">
                    @Html.DisplayFor(model => model.IdClaseTipCam)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Descripcion)
                </dt>
                <dd class="col-sm-8" id="clasetipocambio_details_descripcion">
                    @Html.DisplayFor(model => model.Descripcion)
                </dd>
            </dl>

            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.IdClaseTipCam" class="btn btn-warning" id="clasetipocambio_details_editar">Editar</a>
                <a asp-action="Index" class="btn btn-secondary" id="clasetipocambio_details_volver">Volver al Listado</a>
            </div>
        </div>
    </div>
</div>
