@model ActifWebCRUD.Models.PlantillaEdificio

@{
    ViewData["Title"] = "Eliminar Plantilla Edificio";
}

<div class="crud-container">
    <h1 class="crud-title">Eliminar Plantilla Edificio</h1>

    <h3>¿Está seguro de que desea eliminar este registro?</h3>
    <div class="form-container">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdPlantilla)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IdPlantilla)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Plantilla)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Plantilla)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.TipoDepreciacion)
            </dt>
            <dd class="col-sm-9">
                @if (Model.TipoDepreciacion != null)
                {
                    @Html.DisplayFor(model => model.TipoDepreciacion!.Descripcion)
                }
                else
                {
                    <text>N/A</text>
                }
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.TomaEdificio)
            </dt>
            <dd class="col-sm-9">
                @(Model.TomaEdificio.HasValue ? (Model.TomaEdificio.Value ? "Sí" : "No") : "N/A")
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.TomaCC)
            </dt>
            <dd class="col-sm-9">
                @(Model.TomaCC.HasValue ? (Model.TomaCC.Value ? "Sí" : "No") : "N/A")
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Compania)
            </dt>
            <dd class="col-sm-9">
                @if (Model.Compania != null)
                {
                    @Html.DisplayFor(model => model.Compania!.Nombre)
                }
                else
                {
                    <text>N/A</text>
                }
            </dd>
        </dl>

        <form asp-action="Delete" id="plantillaedificio_delete_form">
            <input type="hidden" asp-for="IdPlantilla" />
            <button type="submit" class="btn btn-danger" id="plantillaedificio_delete_submit">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary" id="plantillaedificio_delete_cancel">Cancelar</a>
        </form>
    </div>
</div>
