@model ActifWebCRUD.Models.PlantillaEdificio

@{
    ViewData["Title"] = "Editar Plantilla Edificio";
}

<div class="crud-container">
    <h1 class="crud-title">Editar Plantilla Edificio</h1>

    <div class="form-container">
        <form asp-action="Edit" id="plantillaedificio_edit_form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdPlantilla" id="plantillaedificio_edit_idplantilla" />

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Plantilla" class="control-label"></label>
                        <input asp-for="Plantilla" class="form-control" id="plantillaedificio_edit_plantilla" maxlength="120" />
                        <span asp-validation-for="Plantilla" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdTipoDep" class="control-label"></label>
                        <select asp-for="IdTipoDep" class="form-control" asp-items="ViewBag.IdTipoDep" id="plantillaedificio_edit_idtipodep">
                        </select>
                        <span asp-validation-for="IdTipoDep" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="TomaEdificio" class="control-label"></label>
                        <select asp-for="TomaEdificio" class="form-control" id="plantillaedificio_edit_tomaedificio">
                            <option value="">-- Seleccione --</option>
                            <option value="true">Sí</option>
                            <option value="false">No</option>
                        </select>
                        <span asp-validation-for="TomaEdificio" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="TomaCC" class="control-label"></label>
                        <select asp-for="TomaCC" class="form-control" id="plantillaedificio_edit_tomacc">
                            <option value="">-- Seleccione --</option>
                            <option value="true">Sí</option>
                            <option value="false">No</option>
                        </select>
                        <span asp-validation-for="TomaCC" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="IdCompania" class="control-label"></label>
                        <select asp-for="IdCompania" class="form-control" asp-items="ViewBag.IdCompania" id="plantillaedificio_edit_idcompania">
                        </select>
                        <span asp-validation-for="IdCompania" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary" id="plantillaedificio_edit_submit">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary" id="plantillaedificio_edit_cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
