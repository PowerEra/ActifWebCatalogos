@model IEnumerable<ActifWebCRUD.Models.PlantillaEdificio>

@{
    ViewData["Title"] = "Plantilla Edificio";
}

<div class="crud-container">
    <h1 class="crud-title">Plantilla Edificio</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="plantillaedificio_add_button">
            <i class="fas fa-plus"></i> Agregar Nueva Plantilla
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="plantillaedificio_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="plantillaEdificioTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID Plantilla</th>
                <th>Plantilla</th>
                <th>ID Tipo Depreciación</th>
                <th>Toma Edificio</th>
                <th>Toma CC</th>
                <th>ID Compañía</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Plantilla" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Tipo Dep" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Toma Edificio" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Toma CC" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Compañía" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdPlantilla</td>
                    <td>@item.Plantilla</td>
                    <td>@item.IdTipoDep</td>
                    <td>@(item.TomaEdificio.HasValue ? (item.TomaEdificio.Value ? "Sí" : "No") : "")</td>
                    <td>@(item.TomaCC.HasValue ? (item.TomaCC.Value ? "Sí" : "No") : "")</td>
                    <td>@item.IdCompania</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdPlantilla" class="action-icon icon-edit" title="Editar" id="plantillaedificio_edit_@item.IdPlantilla">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdPlantilla" class="action-icon icon-delete" title="Eliminar" id="plantillaedificio_delete_@item.IdPlantilla">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#plantillaEdificioTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 6 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 6) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "PlantillaEdificio")';
        }
    </script>
}
