@model ActifWebCRUD.Models.ActifCompaniaTipoDepreciacion

@{
    ViewData["Title"] = "Eliminar Compania Tipo Depreciacion";
}

<div class="crud-container">
    <h1 class="crud-title">Eliminar Compania Tipo Depreciacion</h1>

    <h3>¿Está seguro de que desea eliminar este registro?</h3>
    <div>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdCompaniaDepreciacion)
            </dt>
            <dd class="col-sm-9" id="actifcompaniatipodepreciacion_delete_idcompaniadepreciacion">
                @Html.DisplayFor(model => model.IdCompaniaDepreciacion)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdCompania)
            </dt>
            <dd class="col-sm-9" id="actifcompaniatipodepreciacion_delete_idcompania">
                @Html.DisplayFor(model => model.IdCompania)
            </dd>
            <dt class="col-sm-3">
                Nombre Compania
            </dt>
            <dd class="col-sm-9" id="actifcompaniatipodepreciacion_delete_nombrecompania">
                @Html.DisplayFor(model => model.Compania.Nombre)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdTipoDep)
            </dt>
            <dd class="col-sm-9" id="actifcompaniatipodepreciacion_delete_idtipodep">
                @Html.DisplayFor(model => model.IdTipoDep)
            </dd>
            <dt class="col-sm-3">
                Descripcion Tipo Depreciacion
            </dt>
            <dd class="col-sm-9" id="actifcompaniatipodepreciacion_delete_descripciontipodep">
                @Html.DisplayFor(model => model.TipoDepreciacion.Descripcion)
            </dd>
        </dl>

        <form asp-action="Delete" id="actifcompaniatipodepreciacion_delete_form">
            <input type="hidden" asp-for="IdCompaniaDepreciacion" />
            <input type="submit" value="Eliminar" class="btn btn-danger" id="actifcompaniatipodepreciacion_delete_confirm" />
            <a asp-action="Index" class="btn btn-secondary" id="actifcompaniatipodepreciacion_delete_cancel">Cancelar</a>
        </form>
    </div>
</div>
