@model IEnumerable<ActifWebCRUD.Models.ActifCompaniaTipoDepreciacion>

@{
    ViewData["Title"] = "Compania Tipo Depreciacion";
}

<div class="crud-container">
    <h1 class="crud-title">Compania Tipo Depreciacion</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="actifcompaniatipodepreciacion_add_button">
            <i class="fas fa-plus"></i> Agregar Nueva Relacion
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="actifcompaniatipodepreciacion_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="actifCompaniaTipoDepreciacionTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>ID Compania</th>
                <th>Nombre Compania</th>
                <th>ID Tipo Depreciacion</th>
                <th>Descripcion Tipo Depreciacion</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID Cia" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Compania" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID Tipo" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Tipo Dep" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdCompaniaDepreciacion</td>
                    <td>@item.IdCompania</td>
                    <td>@item.Compania?.Nombre</td>
                    <td>@item.IdTipoDep</td>
                    <td>@item.TipoDepreciacion?.Descripcion</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdCompaniaDepreciacion" class="action-icon icon-edit" title="Editar" id="actifcompaniatipodepreciacion_edit_@item.IdCompaniaDepreciacion">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdCompaniaDepreciacion" class="action-icon icon-delete" title="Eliminar" id="actifcompaniatipodepreciacion_delete_@item.IdCompaniaDepreciacion">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#actifCompaniaTipoDepreciacionTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "desc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 5 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 5) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "ActifCompaniaTipoDepreciacion")';
        }
    </script>
}
