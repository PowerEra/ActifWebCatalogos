@model ActifWebCRUD.Models.TipoActivo

@{
    ViewData["Title"] = "Editar Tipo de Activo";
}

<div class="crud-container">
    <h1 class="crud-title">Editar Tipo de Activo</h1>

    <div class="form-container">
        <form asp-action="Edit" id="tipoactivo_edit_form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdTipoActivo" />

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Descripcion" class="control-label"></label>
                        <input asp-for="Descripcion" class="form-control" id="tipoactivo_edit_descripcion" />
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="IdCompania" class="control-label"></label>
                        <select asp-for="IdCompania" class="form-control" asp-items="ViewBag.IdCompania" id="tipoactivo_edit_idcompania">
                        </select>
                        <span asp-validation-for="IdCompania" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary" id="tipoactivo_edit_submit">Guardar Cambios</button>
                <a asp-action="Index" class="btn btn-secondary" id="tipoactivo_edit_cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
