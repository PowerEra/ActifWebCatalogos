@model ActifWebCRUD.Models.TipoActivo

@{
    ViewData["Title"] = "Eliminar Tipo de Activo";
}

<div class="crud-container">
    <h1 class="crud-title">Eliminar Tipo de Activo</h1>

    <h3>Esta seguro que desea eliminar este registro?</h3>
    <div class="form-container">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdTipoActivo)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IdTipoActivo)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Descripcion)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Descripcion)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdCompania)
            </dt>
            <dd class="col-sm-9">
                @(Model.Compania?.Nombre ?? "N/A")
            </dd>
        </dl>

        <form asp-action="Delete" id="tipoactivo_delete_form">
            <input type="hidden" asp-for="IdTipoActivo" />
            <button type="submit" class="btn btn-danger" id="tipoactivo_delete_submit">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary" id="tipoactivo_delete_cancel">Cancelar</a>
        </form>
    </div>
</div>
