@model IEnumerable<ActifWebCRUD.Models.TipoActivo>

@{
    ViewData["Title"] = "Tipos de Activo";
}

<div class="crud-container">
    <h1 class="crud-title">Tipos de Activo</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="tipoactivo_add_button">
            <i class="fas fa-plus"></i> Agregar Nuevo Tipo de Activo
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="tipoactivo_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="tipoActivoTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Descripcion</th>
                <th>Compania</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Descripcion" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Compania" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdTipoActivo</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Compania?.Nombre</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdTipoActivo" class="action-icon icon-edit" title="Editar" id="tipoactivo_edit_@item.IdTipoActivo">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdTipoActivo" class="action-icon icon-delete" title="Eliminar" id="tipoactivo_delete_@item.IdTipoActivo">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#tipoActivoTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 3 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 3) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "TipoActivo")';
        }
    </script>
}
