@model ActifWebCRUD.Models.TipoCalculo

@{
    ViewData["Title"] = "Detalles del Tipo de Cálculo";
}

<link rel="stylesheet" href="~/css/actif-crud.css" />

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.IdTipoCalculo)
                </dt>
                <dd class="col-sm-8" id="tipocalculo_detalles_idtipocalculo">
                    @Html.DisplayFor(model => model.IdTipoCalculo)
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Descripcion)
                </dt>
                <dd class="col-sm-8" id="tipocalculo_detalles_descripcion">
                    @Html.DisplayFor(model => model.Descripcion)
                </dd>
            </dl>

            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.IdTipoCalculo" class="btn btn-warning" id="tipocalculo_detalles_editar">
                    <i class="bi bi-pencil"></i> Editar
                </a>
                <a asp-action="Index" class="btn btn-secondary" id="tipocalculo_detalles_volver">
                    <i class="bi bi-arrow-left"></i> Volver al Listado
                </a>
            </div>
        </div>
    </div>
</div>
