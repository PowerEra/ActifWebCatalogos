@model ActifWebCRUD.Models.TipoCalculo

@{
    ViewData["Title"] = "Editar Tipo de Cálculo";
}

<link rel="stylesheet" href="~/css/actif-crud.css" />

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" id="tipocalculo_editar_form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="IdTipoCalculo" />

                <div class="form-group mb-3">
                    <label asp-for="IdTipoCalculo" class="control-label"></label>
                    <input asp-for="IdTipoCalculo" class="form-control" disabled />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Descripcion" class="control-label"></label>
                    <input asp-for="Descripcion" class="form-control" id="tipocalculo_editar_descripcion" />
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" class="btn btn-primary" id="tipocalculo_editar_guardar">
                        <i class="bi bi-save"></i> Guardar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary" id="tipocalculo_editar_cancelar">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
