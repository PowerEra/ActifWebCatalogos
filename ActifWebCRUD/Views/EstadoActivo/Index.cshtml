@model IEnumerable<ActifWebCRUD.Models.EstadoActivo>

@{
    ViewData["Title"] = "Estados de Activo";
}

<div class="crud-container">
    <h1 class="crud-title">Estados de Activo</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="estadoactivo_add_button">
            <i class="fas fa-plus"></i> Agregar Nuevo Estado de Activo
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="estadoactivo_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="estadoActivoTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Descripcion</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Descripcion" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdEstadoActivo</td>
                    <td>@item.Descripcion</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdEstadoActivo" class="action-icon icon-edit" title="Editar" id="estadoactivo_edit_@item.IdEstadoActivo">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdEstadoActivo" class="action-icon icon-delete" title="Eliminar" id="estadoactivo_delete_@item.IdEstadoActivo">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#estadoActivoTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 2 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 2) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "EstadoActivo")';
        }
    </script>
}
