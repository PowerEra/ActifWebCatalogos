@model ActifWebCRUD.Models.EstadoActivo

@{
    ViewData["Title"] = "Editar Estado de Activo";
}

<div class="crud-container">
    <h1 class="crud-title">Editar Estado de Activo</h1>

    <div class="form-container">
        <form asp-action="Edit" id="estadoactivo_edit_form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdEstadoActivo" />

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="IdEstadoActivo" class="control-label"></label>
                        <input asp-for="IdEstadoActivo" class="form-control" disabled id="estadoactivo_edit_id" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Descripcion" class="control-label"></label>
                        <input asp-for="Descripcion" class="form-control" id="estadoactivo_edit_descripcion" maxlength="20" />
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary" id="estadoactivo_edit_submit">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary" id="estadoactivo_edit_cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
