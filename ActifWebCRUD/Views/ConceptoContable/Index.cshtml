@model IEnumerable<ActifWebCRUD.Models.VConceptoContable>

@{
    ViewData["Title"] = "Conceptos Contables (03.18 Conceptos Pólizas)";
}

<div class="crud-container">
    <h1 class="crud-title">Conceptos Contables (03.18 Conceptos Pólizas)</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="conceptocontable_add_button">
            <i class="fas fa-plus"></i> Agregar Nuevo Concepto Contable
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="conceptocontable_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="conceptoContableTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Compañía</th>
                <th>Tipo Activo</th>
                <th>Subtipo Activo</th>
                <th>Variable</th>
                <th>Descripción</th>
                <th>CTA101</th>
                <th>CTA201</th>
                <th>Edificio</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Compañía" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Tipo Activo" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Subtipo" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Variable" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Descripción" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar CTA101" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar CTA201" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Edificio" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdConcepto</td>
                    <td>@item.Compania</td>
                    <td>@item.TipoActivo</td>
                    <td>@item.SubtipoActivo</td>
                    <td>@item.Variable</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Cta101</td>
                    <td>@item.Cta201</td>
                    <td>@item.Edificio</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdConcepto" class="action-icon icon-edit" title="Editar" id="conceptocontable_edit_@item.IdConcepto">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdConcepto" class="action-icon icon-delete" title="Eliminar" id="conceptocontable_delete_@item.IdConcepto">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#conceptoContableTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 9 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 9) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "ConceptoContable")';
        }
    </script>
}
