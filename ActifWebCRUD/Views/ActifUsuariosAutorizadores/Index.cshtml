@model IEnumerable<ActifWebCRUD.Models.ActifUsuariosAutorizadores>

@{
    ViewData["Title"] = "Usuarios Autorizadores";
}

<div class="crud-container">
    <h1 class="crud-title">Usuarios Autorizadores</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="actifusuariosautorizadores_add_button">
            <i class="fas fa-plus"></i> Agregar Nuevo
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="actifusuariosautorizadores_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="actifUsuariosAutorizadoresTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID Autorizador</th>
                <th>ID Usuario</th>
                <th>Usuario</th>
                <th>ID Compañía</th>
                <th>Compañía</th>
                <th>ID Edificio</th>
                <th>Edificio</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID Usuario" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Usuario" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID Compañía" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Compañía" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID Edificio" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Edificio" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdUsuarioAutorizador</td>
                    <td>@item.IdUsuario</td>
                    <td>@item.UserName</td>
                    <td>@item.IdCompania</td>
                    <td>@item.CompaniaName</td>
                    <td>@item.IdEdificio</td>
                    <td>@item.EdificioDesc</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdUsuarioAutorizador" class="action-icon icon-edit" title="Editar" id="actifusuariosautorizadores_edit_@item.IdUsuarioAutorizador">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdUsuarioAutorizador" class="action-icon icon-delete" title="Eliminar" id="actifusuariosautorizadores_delete_@item.IdUsuarioAutorizador">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#actifUsuariosAutorizadoresTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 7 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 7) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "ActifUsuariosAutorizadores")';
        }
    </script>
}
