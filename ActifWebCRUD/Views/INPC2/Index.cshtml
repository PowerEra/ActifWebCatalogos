@model IEnumerable<ActifWebCRUD.Models.INPC2>

@{
    ViewData["Title"] = "INPC2";
}

<div class="crud-container">
    <h1 class="crud-title">INPC2 - Índice Nacional de Precios al Consumidor</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="inpc2_add_button">
            <i class="fas fa-plus"></i> Agregar Nuevo Registro INPC2
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="inpc2_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="inpc2Table" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID INPC</th>
                <th>Año</th>
                <th>Mes</th>
                <th>Grupo Simulación</th>
                <th>País</th>
                <th>Índice</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Año" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Mes" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Grupo" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar País" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Índice" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdInpc</td>
                    <td>@item.Anio</td>
                    <td>@item.Mes</td>
                    <td>@item.GrupoSimulacion?.Descripcion</td>
                    <td>@item.Pais?.Nombre</td>
                    <td>@item.Indice?.ToString("N6")</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdInpc" class="action-icon icon-edit" title="Editar" id="inpc2_edit_@item.IdInpc">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdInpc" class="action-icon icon-delete" title="Eliminar" id="inpc2_delete_@item.IdInpc">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#inpc2Table').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 6 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 6) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "INPC2")';
        }
    </script>
}
