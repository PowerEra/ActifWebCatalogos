@model IEnumerable<ActifWebCRUD.Models.ActifTipoDepEdificio>

@{
    ViewData["Title"] = "Tipo Depreciación por Edificio";
}

<div class="crud-container">
    <h1 class="crud-title">Tipo Depreciación por Edificio</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="actiftipodepedificio_add_button">
            <i class="fas fa-plus"></i> Agregar Nuevo
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="actiftipodepedificio_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="actifTipoDepEdificioTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tipo Depreciación</th>
                <th>Edificio</th>
                <th>Fecha Captura</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Tipo" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Edificio" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Fecha" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Idx</td>
                    <td>@(item.IdTipoDep == 77 ? "Rev. convertido a DLS" : item.TipoDepreciacion?.Descripcion)</td>
                    <td>@item.Edificio?.Descripcion</td>
                    <td>@(item.FechaCaptura?.ToString("yyyy-MM-dd HH:mm:ss"))</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.Idx" class="action-icon icon-edit" title="Editar" id="actiftipodepedificio_edit_@item.Idx">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Idx" class="action-icon icon-delete" title="Eliminar" id="actiftipodepedificio_delete_@item.Idx">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#actifTipoDepEdificioTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 4 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 4) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "ActifTipoDepEdificio")';
        }
    </script>
}
