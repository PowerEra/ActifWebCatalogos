@model ActifWebCRUD.Models.ActifTipoDepEdificio

@{
    ViewData["Title"] = "Eliminar Tipo Depreciación por Edificio";
}

<div class="crud-container">
    <h1 class="crud-title">Eliminar Tipo Depreciación por Edificio</h1>

    <h3>¿Está seguro que desea eliminar este registro?</h3>
    <div class="form-container">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Idx)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Idx)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdTipoDep)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IdTipoDep)
            </dd>
            <dt class="col-sm-3">
                Descripción Tipo Depreciación
            </dt>
            <dd class="col-sm-9">
                @Model.TipoDepreciacion?.Descripcion
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdEdificio)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IdEdificio)
            </dd>
            <dt class="col-sm-3">
                Descripción Edificio
            </dt>
            <dd class="col-sm-9">
                @Model.Edificio?.Descripcion
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.FechaCaptura)
            </dt>
            <dd class="col-sm-9">
                @(Model.FechaCaptura?.ToString("yyyy-MM-dd HH:mm:ss"))
            </dd>
        </dl>

        <form asp-action="Delete" id="actiftipodepedificio_delete_form">
            <input type="hidden" asp-for="Idx" />
            <button type="submit" class="btn btn-danger" id="actiftipodepedificio_delete_submit">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary" id="actiftipodepedificio_delete_cancel">Cancelar</a>
        </form>
    </div>
</div>
