@model ActifWebCRUD.Models.ActifTipoDepEdificio

@{
    ViewData["Title"] = "Editar Tipo Depreciación por Edificio";
}

<div class="crud-container">
    <h1 class="crud-title">Editar Tipo Depreciación por Edificio</h1>

    <div class="form-container">
        <form asp-action="Edit" id="actiftipodepedificio_edit_form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Idx" id="actiftipodepedificio_edit_idx" />

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdTipoDep" class="control-label"></label>
                        <select asp-for="IdTipoDep" class="form-control" asp-items="ViewBag.IdTipoDep" id="actiftipodepedificio_edit_tipodep">
                            <option value="">-- Seleccione Tipo Depreciación --</option>
                        </select>
                        <span asp-validation-for="IdTipoDep" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdEdificio" class="control-label"></label>
                        <select asp-for="IdEdificio" class="form-control" asp-items="ViewBag.IdEdificio" id="actiftipodepedificio_edit_edificio">
                            <option value="">-- Seleccione Edificio --</option>
                        </select>
                        <span asp-validation-for="IdEdificio" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="FechaCaptura" class="control-label"></label>
                        <input asp-for="FechaCaptura" class="form-control" type="datetime-local" id="actiftipodepedificio_edit_fecha" />
                        <span asp-validation-for="FechaCaptura" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary" id="actiftipodepedificio_edit_submit">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary" id="actiftipodepedificio_edit_cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
