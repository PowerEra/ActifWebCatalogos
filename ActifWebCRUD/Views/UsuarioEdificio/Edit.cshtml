@model ActifWebCRUD.Models.UsuarioEdificio

@{
    ViewData["Title"] = "Editar Usuario Edificio";
}

<div class="crud-container">
    <h1 class="crud-title">Editar Usuario Edificio</h1>

    <div class="form-container">
        <form asp-action="Edit" id="usuarioedificio_edit_form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdUsuarioEdificio" />

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="IdUsuario" class="control-label"></label>
                        <select asp-for="IdUsuario" class="form-control" asp-items="ViewBag.IdUsuario" id="usuarioedificio_edit_idusuario">
                        </select>
                        <span asp-validation-for="IdUsuario" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="IdCompania" class="control-label"></label>
                        <select asp-for="IdCompania" class="form-control" asp-items="ViewBag.IdCompania" id="usuarioedificio_edit_idcompania">
                        </select>
                        <span asp-validation-for="IdCompania" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="IdEdificio" class="control-label"></label>
                        <select asp-for="IdEdificio" class="form-control" asp-items="ViewBag.IdEdificio" id="usuarioedificio_edit_idedificio">
                        </select>
                        <span asp-validation-for="IdEdificio" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary" id="usuarioedificio_edit_submit">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary" id="usuarioedificio_edit_cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
