@model ActifWebCRUD.Models.Estado

@{
    ViewData["Title"] = "Editar Estado";
}

<div class="crud-container">
    <h1 class="crud-title">Editar Estado</h1>

    <div class="form-container">
        <form asp-action="Edit" id="estado_edit_form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdEstado" />

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Nombre" class="control-label"></label>
                        <input asp-for="Nombre" class="form-control" id="estado_edit_nombre" maxlength="60" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="IdPais" class="control-label"></label>
                        <select asp-for="IdPais" class="form-control" asp-items="ViewBag.IdPais" id="estado_edit_idpais">
                        </select>
                        <span asp-validation-for="IdPais" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary" id="estado_edit_submit">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary" id="estado_edit_cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
