@model ActifWebCRUD.Models.Estado

@{
    ViewData["Title"] = "Eliminar Estado";
}

<div class="crud-container">
    <h1 class="crud-title">Eliminar Estado</h1>

    <h3>¿Está seguro de que desea eliminar este registro?</h3>
    <div class="form-container">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdEstado)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IdEstado)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Nombre)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Nombre)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Pais)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Pais!.Nombre)
            </dd>
        </dl>

        <form asp-action="Delete" id="estado_delete_form">
            <input type="hidden" asp-for="IdEstado" />
            <button type="submit" class="btn btn-danger" id="estado_delete_submit">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary" id="estado_delete_cancel">Cancelar</a>
        </form>
    </div>
</div>
