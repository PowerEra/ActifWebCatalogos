@model ActifWebCRUD.Models.UsersCampanias

@{
    ViewData["Title"] = "Crear Usuario Compania";
}

<div class="crud-container">
    <h1 class="crud-title">Crear Nueva Relacion Usuario-Compania</h1>

    <div class="form-container">
        <form asp-action="Create" id="userscampanias_create_form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdUser" class="control-label"></label>
                        <select asp-for="IdUser" class="form-control" asp-items="ViewBag.IdUser" id="userscampanias_create_iduser">
                            <option value="">-- Seleccione Usuario --</option>
                        </select>
                        <span asp-validation-for="IdUser" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdCompania" class="control-label"></label>
                        <select asp-for="IdCompania" class="form-control" asp-items="ViewBag.IdCompania" id="userscampanias_create_idcompania">
                            <option value="">-- Seleccione Compania --</option>
                        </select>
                        <span asp-validation-for="IdCompania" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary" id="userscampanias_create_submit">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary" id="userscampanias_create_cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
