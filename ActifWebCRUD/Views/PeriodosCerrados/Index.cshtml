@model IEnumerable<ActifWebCRUD.Models.PeriodosCerrados>

@{
    ViewData["Title"] = "Periodos Cerrados";
}

<div class="crud-container">
    <h1 class="crud-title">Periodos Cerrados</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="periodoscerrados_add_button">
            <i class="fas fa-plus"></i> Agregar Nuevo Periodo Cerrado
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="periodoscerrados_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="periodosCerradosTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID Cierre</th>
                <th>Año</th>
                <th>Mes</th>
                <th>ID Compania</th>
                <th>Nombre Compania</th>
                <th>Fecha Cierre</th>
                <th>ID Usuario Cierre</th>
                <th>ID Tipo Dep</th>
                <th>Descripcion Tipo Dep</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Año" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Mes" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID Cia" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Compania" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Fecha" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Usuario" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID Tipo" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Tipo Dep" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdCierreCompania</td>
                    <td>@item.Anio</td>
                    <td>@item.Mes</td>
                    <td>@item.IdCompania</td>
                    <td>@item.Compania?.Nombre</td>
                    <td>@(item.FechaCierre?.ToString("dd/MM/yyyy HH:mm"))</td>
                    <td>@item.IdUsuarioCierre</td>
                    <td>@item.IdTipoDep</td>
                    <td>@item.TipoDepreciacion?.Descripcion</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdCierreCompania" class="action-icon icon-edit" title="Editar" id="periodoscerrados_edit_@item.IdCierreCompania">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdCierreCompania" class="action-icon icon-delete" title="Eliminar" id="periodoscerrados_delete_@item.IdCierreCompania">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#periodosCerradosTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "desc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 9 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 9) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "PeriodosCerrados")';
        }
    </script>
}
