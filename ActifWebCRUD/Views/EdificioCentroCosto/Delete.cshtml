@model ActifWebCRUD.Models.EdificioCentroCosto

@{
    ViewData["Title"] = "Eliminar Edificio Centro Costo";
}

<div class="crud-container">
    <h1 class="crud-title">Eliminar Relación Edificio-Centro Costo</h1>

    <h3>¿Está seguro que desea eliminar esta relación?</h3>
    <div class="form-container">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdEdificioCentroCosto)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IdEdificioCentroCosto)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdCompania)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IdCompania)
            </dd>
            <dt class="col-sm-3">
                Nombre Compañía
            </dt>
            <dd class="col-sm-9">
                @Model.Compania?.Nombre
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdEdificio)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IdEdificio)
            </dd>
            <dt class="col-sm-3">
                Descripción Edificio
            </dt>
            <dd class="col-sm-9">
                @Model.Edificio?.Descripcion
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IdCentroCosto)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.IdCentroCosto)
            </dd>
            <dt class="col-sm-3">
                Centro Costo
            </dt>
            <dd class="col-sm-9">
                @Model.CentroCosto?.Descripcion
            </dd>
        </dl>

        <form asp-action="Delete" id="edificiocentrocosto_delete_form">
            <input type="hidden" asp-for="IdEdificioCentroCosto" />
            <button type="submit" class="btn btn-danger" id="edificiocentrocosto_delete_submit">Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary" id="edificiocentrocosto_delete_cancel">Cancelar</a>
        </form>
    </div>
</div>
