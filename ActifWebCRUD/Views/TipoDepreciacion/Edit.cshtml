@model ActifWebCRUD.Models.TipoDepreciacion

@{
    ViewData["Title"] = "Editar Tipo de Depreciacion";
}

<div class="crud-container">
    <h1 class="crud-title">Editar Tipo de Depreciacion</h1>

    <div class="form-container">
        <form asp-action="Edit" id="tipodepreciacion_edit_form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="IdTipoDep" />

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="IdTipoDep" class="control-label"></label>
                        <input asp-for="IdTipoDep" class="form-control" type="number" disabled id="tipodepreciacion_edit_id" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Descripcion" class="control-label"></label>
                        <input asp-for="Descripcion" class="form-control" id="tipodepreciacion_edit_descripcion" />
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="MesIni" class="control-label"></label>
                        <input asp-for="MesIni" class="form-control" type="number" id="tipodepreciacion_edit_mesini" />
                        <span asp-validation-for="MesIni" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="AplicaFiscal" class="control-label"></label>
                        <input asp-for="AplicaFiscal" class="form-control" type="number" id="tipodepreciacion_edit_aplicafiscal" />
                        <span asp-validation-for="AplicaFiscal" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary" id="tipodepreciacion_edit_submit">Guardar Cambios</button>
                <a asp-action="Index" class="btn btn-secondary" id="tipodepreciacion_edit_cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
