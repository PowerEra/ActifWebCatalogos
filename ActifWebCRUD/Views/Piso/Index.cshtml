@model IEnumerable<ActifWebCRUD.Models.Piso>

@{
    ViewData["Title"] = "Pisos";
}

<div class="crud-container">
    <h1 class="crud-title">Pisos</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="piso_add_button">
            <i class="fas fa-plus"></i> Agregar Nuevo Piso
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="piso_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="pisoTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID Piso</th>
                <th>Descripcion</th>
                <th>ID Compania</th>
                <th>ID Edificio</th>
                <th>ID Piso Anterior</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Descripcion" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID Compania" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Edificio" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Piso Ant." /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdPiso</td>
                    <td>@item.Descripcion</td>
                    <td>@item.IdCompania</td>
                    <td>@item.IdEdificio</td>
                    <td>@item.IdPisoAnterior</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdPiso" class="action-icon icon-edit" title="Editar" id="piso_edit_@item.IdPiso">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdPiso" class="action-icon icon-delete" title="Eliminar" id="piso_delete_@item.IdPiso">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#pisoTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 5 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 5) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "Piso")';
        }
    </script>
}
