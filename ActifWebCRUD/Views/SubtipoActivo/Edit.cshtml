@model ActifWebCRUD.Models.SubtipoActivo

@{
    ViewData["Title"] = "Editar Subtipo de Activo";
}

<div class="crud-container">
    <h1 class="crud-title">Editar Subtipo de Activo</h1>

    <div class="form-container">
        <form asp-action="Edit" id="subtipoactivo_edit_form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdSubtipoActivo" />

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="IdTipoActivo" class="control-label"></label>
                        <select asp-for="IdTipoActivo" class="form-control" asp-items="ViewBag.IdTipoActivo" id="subtipoactivo_edit_idtipoactivo">
                        </select>
                        <span asp-validation-for="IdTipoActivo" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Descripcion" class="control-label"></label>
                        <input asp-for="Descripcion" class="form-control" id="subtipoactivo_edit_descripcion" />
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Actualizar" class="control-label"></label>
                        <input asp-for="Actualizar" class="form-control" maxlength="1" id="subtipoactivo_edit_actualizar" />
                        <span asp-validation-for="Actualizar" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Codigo" class="control-label"></label>
                        <input asp-for="Codigo" class="form-control" maxlength="6" id="subtipoactivo_edit_codigo" />
                        <span asp-validation-for="Codigo" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary" id="subtipoactivo_edit_submit">Guardar Cambios</button>
                <a asp-action="Index" class="btn btn-secondary" id="subtipoactivo_edit_cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
