@model IEnumerable<ActifWebCRUD.Models.VCentroCosto>

@{
    ViewData["Title"] = "Centros de Costo";
}

<div class="crud-container">
    <h1 class="crud-title">Centros de Costo</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="centrocosto_add_button">
            <i class="fas fa-plus"></i> Agregar Nuevo Centro de Costo
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="centrocosto_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="centroCostoTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Compañía</th>
                <th>Código</th>
                <th>Descripción</th>
                <th>Responsable</th>
                <th>Status</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Compañía" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Código" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Descripción" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Responsable" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Status" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdCentroCosto</td>
                    <td>@item.Compania</td>
                    <td>@item.Codigo</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Responsable</td>
                    <td>@item.Status</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdCentroCosto" class="action-icon icon-edit" title="Editar" id="centrocosto_edit_@item.IdCentroCosto">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdCentroCosto" class="action-icon icon-delete" title="Eliminar" id="centrocosto_delete_@item.IdCentroCosto">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#centroCostoTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 6 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 6) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "CentroCosto")';
        }
    </script>
}
