@model IEnumerable<ActifWebCRUD.Models.VEdificio>

@{
    ViewData["Title"] = "Edificios";
}

<div class="crud-container">
    <h1 class="crud-title">Edificios</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn-add-new" id="edificio_add_button">
            <i class="fas fa-plus"></i> Agregar Nuevo Edificio
        </a>
        <button onclick="exportToExcel()" class="btn-export-excel" id="edificio_export_button">
            <i class="fas fa-file-excel"></i> Exportar a Excel
        </button>
    </div>

    <table id="edificioTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Compañía</th>
                <th>Descripción</th>
                <th>Calle y Número</th>
                <th>Colonia</th>
                <th>Delegación/Municipio</th>
                <th>Código Postal</th>
                <th>ID Estado</th>
                <th>Teléfono</th>
                <th>Inactivo</th>
                <th>Acciones</th>
            </tr>
            <tr>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar ID" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Compañía" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Descripción" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Calle" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Colonia" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Deleg/Mpio" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar CP" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Estado" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Teléfono" /></th>
                <th><input type="text" class="form-control form-control-sm" placeholder="Filtrar Inactivo" /></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdEdificio</td>
                    <td>@item.Compania</td>
                    <td>@item.Descripcion</td>
                    <td>@item.CalleNumero</td>
                    <td>@item.Colonia</td>
                    <td>@item.DelegMpio</td>
                    <td>@item.CodigoPostal</td>
                    <td>@item.IdEstado</td>
                    <td>@item.Telefono</td>
                    <td>@item.Inactivo</td>
                    <td>
                        <div class="action-icons">
                            <a asp-action="Edit" asp-route-id="@item.IdEdificio" class="action-icon icon-edit" title="Editar" id="edificio_edit_@item.IdEdificio">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.IdEdificio" class="action-icon icon-delete" title="Eliminar" id="edificio_delete_@item.IdEdificio">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            var table = $('#edificioTable').DataTable({
                "pageLength": 50,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                },
                "order": [[0, "asc"]],
                "columnDefs": [
                    { "orderable": false, "targets": 10 }
                ],
                "initComplete": function () {
                    // Apply the search
                    this.api().columns().every(function (index) {
                        if (index === 10) return; // Skip actions column

                        var column = this;
                        $('input', this.header()).on('keyup change clear', function () {
                            if (column.search() !== this.value) {
                                column.search(this.value).draw();
                            }
                        });
                    });
                }
            });
        });

        function exportToExcel() {
            window.location.href = '@Url.Action("ExportToExcel", "Edificio")';
        }
    </script>
}
